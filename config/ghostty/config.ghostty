# Send Option-key combinations as terminal Alt sequences instead of macOS
# Unicode characters (for example, Option-j should not produce ∆).
macos-option-as-alt = true

# Match the vscode.nvim light/dark palette and follow the macOS appearance.
theme = light:VSCode Light,dark:VSCode Dark

# Clipboard: Ctrl+C copies when the terminal has a selection and still
# reaches the program as SIGINT otherwise; Ctrl+V always pastes.
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard

# macOS-style line editing: Cmd+Left/Right and Cmd+Backspace reach the shell
# and Neovim as Home/End and Ctrl+U.
keybind = cmd+left=text:\x1b[H
keybind = cmd+right=text:\x1b[F
keybind = cmd+backspace=text:\x15
# Cmd+Up/Down arrive as Ctrl+Up/Down (document begin/end in Neovim).
keybind = cmd+up=text:\x1b[1;5A
keybind = cmd+down=text:\x1b[1;5B

# Detect plain URLs and show link previews.
link-url = true
link-previews = true
